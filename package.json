{
  "name": "allocation-splitter",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "description": "React + TypeScript component library",
  "main": "./dist/allocation-splitter.cjs",
  "module": "./dist/allocation-splitter.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/allocation-splitter.js",
      "require": "./dist/allocation-splitter.cjs"
    },
    "./styles.css": "./dist/allocation-splitter.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "type-check": "tsc -b --noEmit",
    "test:a11y": "vitest run --project=storybook",
    "validate": "npm run lint && npm run type-check && npm run test:a11y"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.64.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.1.0"
  }
}
